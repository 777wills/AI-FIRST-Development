# Inicio código generado por GitHub Copilot
# .env.example — Variables de entorno disponibles para el contenedor Olimpia.Api
# Copiar este archivo a .env y ajustar los valores antes de ejecutar el contenedor.
# En .NET la jerarquía de configuración se separa con __ (doble guion bajo).
# Estas variables sobreescriben los valores de appsettings.json en tiempo de ejecución.
#
# ⚠️ IMPORTANTE - SEGURIDAD:
# 1. Copiar este archivo a .env y completar con valores reales
# 2. NUNCA subir .env al repositorio (está en .gitignore)
# 3. Para producción, usar Docker Secrets, Kubernetes Secrets o Podman Secrets
# 4. Ver sección "Gestión de Secretos" en README.md para más detalles

# ─── ASP.NET Core ────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# ─── Base de datos ───────────────────────────────────────────────────────────
# Opción 1: Variable de entorno directa (NO recomendado para producción)
ConnectionStrings__DefaultConnection=Server=<host>;Database=OlimpiaPrefixDb;User Id=<user>;Password=<password>;TrustServerCertificate=True;

# Opción 2: Usar secreto desde archivo (RECOMENDADO para producción)
# ConnectionStrings__DefaultConnection_File=/run/secrets/db_connection_string

# ─── JWT Authentication (OpenIddict como Authorization Server) ─────────
# Authority: URL base del servidor OpenIddict.
# El API descargará automáticamente las claves de firma desde:
#   {Jwt__Authority}/.well-known/openid-configuration
# Audience: nombre del ApiScope/ApiResource registrado en el servidor OpenIddict.
# RequireHttpsMetadata: false solo en desarrollo local.

# Opción 1: Variable de entorno directa
Jwt__Authority=https://identity.tudominio.com
Jwt__Audience=olimpia-template
Jwt__RequireHttpsMetadata=true

# Opción 2: Usar secreto desde archivo (RECOMENDADO para producción)
# Jwt__Authority_File=/run/secrets/jwt_authority

# ─── Redis Cache ─────────────────────────────────────────────────────────────
RedisCache__Enabled=true
RedisCache__InstanceName=OlimpiaPrefix_Prod_
RedisCache__DefaultExpirationMinutes=60

# Opción 1: Variable de entorno directa (sin password para desarrollo)
RedisCache__ConnectionString=redis:6379

# Opción 2: Con password (NO recomendado para producción)
# RedisCache__ConnectionString=redis:6379,password=<CAMBIAR_PASSWORD>

# Opción 3: Usar secreto desde archivo (RECOMENDADO para producción)
# RedisCache__ConnectionString_File=/run/secrets/redis_connection_string

# ─── Logger personalizado ────────────────────────────────────────────────────
# Niveles válidos: Trace | Debug | Information | Warning | Error | Critical
Logging__CustomLogger__MinimumLevel=Information
Logging__CustomLogger__Path=/app/logs/olimpia-template.log

# ─── Logging Centralizado (LogCentral) ───────────────────────────────────────
Logging__LogCentral__Enabled=true
Logging__LogCentral__BaseUrl=http://logcentral:8080
Logging__LogCentral__Timeout=10000
Logging__LogCentral__RetryAttempts=5
Logging__LogCentral__FailoverPath=/app/logs/offline/

# ─── Reintentos en Repositorios ──────────────────────────────────────────────
Repository__RetryEnabled=true
Repository__MaxRetryAttempts=3
Repository__InitialDelayMs=100

# ─── Reintentos en HttpClient ────────────────────────────────────────────────
HttpClient__RetryEnabled=true
HttpClient__MaxRetryAttempts=3
HttpClient__InitialDelayMs=200

# ─── APIs Externas ───────────────────────────────────────────────────────────
ExternalApis__LogCentralService__BaseUrl=http://logcentral:8080
ExternalApis__CatalogoService__BaseUrl=https://catalogo.internal/
ExternalApis__NotificacionesService__BaseUrl=https://notificaciones.internal/

# ============================================================================
# EJEMPLOS DE USO
# ============================================================================

# ── Docker (desarrollo) ──────────────────────────────────────────────────────
# docker run -p 8080:8080 --env-file .env olimpia-template:latest

# ── Docker Secrets (producción recomendada) ──────────────────────────────────
# 1. Crear secretos:
#    echo "Server=..." | docker secret create db_connection_string -
#    echo "https://identity.prod.com" | docker secret create jwt_authority -
#    echo "redis:6379,password=xxx" | docker secret create redis_connection_string -
#
# 2. Ejecutar con secretos:
#    docker service create \
#      --secret db_connection_string \
#      --secret jwt_authority \
#      --secret redis_connection_string \
#      -e ConnectionStrings__DefaultConnection_File=/run/secrets/db_connection_string \
#      -e Jwt__Authority_File=/run/secrets/jwt_authority \
#      -e RedisCache__ConnectionString_File=/run/secrets/redis_connection_string \
#      -p 8080:8080 \
#      olimpia-template:latest

# ── Kubernetes Secrets (producción recomendada) ──────────────────────────────
# 1. Crear secretos:
#    kubectl create secret generic olimpia-template-db-secret \
#      --from-literal=connection-string='Server=...'
#
#    kubectl create secret generic olimpia-template-jwt-secret \
#      --from-literal=authority='https://identity.prod.com'
#
#    kubectl create secret generic olimpia-template-redis-secret \
#      --from-literal=connection-string='redis:6379,password=xxx'
#
# 2. Ver deployment.yaml en README.md para referenciar secretos

# ── Podman Secrets (producción recomendada) ──────────────────────────────────
# 1. Crear secretos:
#    echo "Server=..." | podman secret create db_connection_string -
#    echo "https://identity.prod.com" | podman secret create jwt_authority -
#
# 2. Ejecutar con secretos:
#    podman run -d \
#      --secret db_connection_string \
#      --secret jwt_authority \
#      -e ConnectionStrings__DefaultConnection_File=/run/secrets/db_connection_string \
#      -e Jwt__Authority_File=/run/secrets/jwt_authority \
#      -p 8080:8080 \
#      olimpia-template:latest

# Fin código generado por GitHub Copilot
