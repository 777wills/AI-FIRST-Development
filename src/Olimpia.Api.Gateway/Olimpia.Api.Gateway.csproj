<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Olimpia.Api.Gateway</RootNamespace>
    <AssemblyName>Olimpia.Api.Gateway</AssemblyName>
    <!-- API Gateway con Ocelot: enruta solicitudes al microservicio correcto,
         propaga el Bearer token transparentemente, y agrega Swagger agregado via MMLib. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="MMLib.Ocelot.Provider.AppConfiguration" Version="4.0.0" />
    <PackageReference Include="MMLib.SwaggerForOcelot" Version="10.0.2" />
    <PackageReference Include="Ocelot" Version="25.0.0" />
  </ItemGroup>

</Project>
